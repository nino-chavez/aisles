BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CLIENT_SECRET=
BIGCOMMERCE_ACCESS_TOKEN=
BIGCOMMERCE_CHANNEL_ID=
BIGCOMMERCE_STOREFRONT_TOKEN=
# Kibble's storefront token, scoped to its default channel (1853406). Falls
# back to BIGCOMMERCE_STOREFRONT_TOKEN above, which is channel 1 — that
# fallback sends a channel-1 token to the 1853406 host and every request fails.
KIBBLE_STOREFRONT_TOKEN=
# Preferred for every Kibble server-to-server Storefront GraphQL call and
# required for customer identity. Include Unauthenticated and Customer scopes.
# Not used while a merchant tier is active — it is scoped to the default
# channel, so the tier's own storefront token wins there.
BIGCOMMERCE_PRIVATE_TOKEN=
ANTHROPIC_API_KEY=
CF_AI_GATEWAY_URL=
OPENROUTER_API_KEY=

# Enables the prospect-triggered, bounded Home shelf model decision. Leave false
# unless Redis is configured for the server-side cooldown and daily budgets.
KIBBLE_DEMO_AI_ENABLED=false

# Real BigCommerce sandbox cart + hosted-checkout handoff. Keep off unless the
# server also has a store hash, storefront token, and durable KV session storage.
KIBBLE_COMMERCE_MODE=off
# Leave unset until BigCommerce is the approved customer identity owner. This
# enables login and order reads, not registration, order creation, or payment.
KIBBLE_CUSTOMER_IDENTITY_MODE=
# Live plan reads are safe without customer identity. Cart-intent writes also
# require KIBBLE_CUSTOMER_IDENTITY_MODE=bigcommerce and BIGCOMMERCE_PRIVATE_TOKEN.
KIBBLE_SUBSCRIPTION_MODE=off
# Local-development fallback only. Production uses the SUBS_API service binding.
SUBS_API_ORIGIN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required for local enrichment and operational telemetry. Use the direct/session
# Supabase Postgres connection string; production uses its HYPERDRIVE binding.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Optional verification-only URL for the least-privilege aisles_app role.
RUNTIME_DATABASE_URL=

# Protects /observe and /api/observe/* in deployed environments. Store the
# production value as a Cloudflare Pages secret, not in wrangler.toml.
OBSERVE_ACCESS_TOKEN=

# Voucherify — incentives engine (Phase 4a). Leave blank to use the stub evaluator.
VOUCHERIFY_API_URL=https://us1.api.voucherify.io
VOUCHERIFY_APP_ID=
VOUCHERIFY_SECRET_KEY=

# Merchant-tier demo toggle (Kibble only). Each pair points the "Small" /
# "Medium" / "Enterprise" option at its own BigCommerce channel. Leave a pair
# blank to leave that tier unprovisioned — the storefront falls back to the
# default channel and the toggle labels it "not yet provisioned".
KIBBLE_TIER_SMALL_CHANNEL_ID=
KIBBLE_TIER_SMALL_STOREFRONT_TOKEN=
KIBBLE_TIER_MEDIUM_CHANNEL_ID=
KIBBLE_TIER_MEDIUM_STOREFRONT_TOKEN=
KIBBLE_TIER_ENTERPRISE_CHANNEL_ID=
KIBBLE_TIER_ENTERPRISE_STOREFRONT_TOKEN=
